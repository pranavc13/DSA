class Solution {
public:
    int beautySum(string s) {
        int totalBeauty = 0;
        for(int i=0; i<s.length(); i++){
            vector<int> freq(26,0);
            for(int j = i; j<s.length(); j++){
                freq[s[j] - 'a']++;
                int maxFreq = 0;
                int minFreq = 1000;

                for(int k=0; k<freq.size(); k++){
                   if(freq[k]>0){
                    maxFreq = max(maxFreq, freq[k]);
                    minFreq = min(minFreq, freq[k]);
                   }

                }
             totalBeauty += maxFreq - minFreq;
            }
            
        }
      return totalBeauty;
    }
};
