#include<iostream>
#include<algorithm>
#include<vector>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int> arr(n);
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    int taxis = 0;
    vector<int> count(5,0);
    for(int i=0; i<n; i++){
        count[arr[i]]++;
    }
    taxis += count[4];
    
    taxis += count[3];
    count[1] = max(0, count[1] - count[3]);
    taxis += count[2] / 2;
    if(count[2] % 2 != 0){
        taxis++;
        count[1] = max(0, count[1] - 2);
    }
    if(count[1] >0) {
        taxis += (count[1] + 3) / 4;
    }
    cout<<taxis<<"\n";
    return 0;
}
