#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include<map>
using namespace std;

int main(){
    int n;
    cin>>n;
    map<int, int> mpp;
    for(int i=0; i<n; i++){
        int start, end;
        cin>>start>>end;
        mpp[start] += 1;
        mpp[end +1]   -=1;
    }
    int currChange = 0;
    int maxChange =0;
    int bestDay = -1;
    for(auto c : mpp){
        currChange += c.second;
        if(currChange > maxChange) {
            maxChange = currChange;
            bestDay = c.first;
        }
    }
    cout<<maxChange<<" "<<bestDay;
    return 0;
}
