class Solution {
public:
    int characterReplacement(string s, int k) {
        int freq[26] = {0};
        int windowSize = 0;
        int element = 0;
        int i = 0;
        int j = 0;
        int maxElement = 0;
        int maximum = 0;
        for(int j=0; j<s.length(); j++){
            freq[s[j] - 'A']++;
            maxElement = max(maxElement, freq[s[j] - 'A']);
            windowSize = j-i+1;
            element = windowSize-maxElement;
            if(element <= k){
              maximum = max(maximum, windowSize);
            }
            else {
                freq[s[i] - 'A']--;
                i++;
            }
        }
        return maximum;
        
    }
};
