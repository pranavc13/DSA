#include<iostream>
#include<algorithm>
using namespace std;
 
int main() {
    int n;
    int t;
    cin>>n;
    cin>>t;
    int arr[n];
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    int sum =0;
    int i=0;
    int maxSum = 0;
    for(int j=0; j<n; j++){  
        sum+= arr[j];
        while(sum>t){
            sum -= arr[i];
            i++;
        }
        maxSum = max(maxSum, j-i+1);
 
    }
 
    cout<<maxSum<<"\n";
    
    return 0;
}
