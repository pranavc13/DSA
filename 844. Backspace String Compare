class Solution {
public:
    bool backspaceCompare(string s, string t) {
        string finalS = buildString(s);
        string finalT = buildString(t);
        return finalS == finalT;
        
    }
 private:
    string buildString(const string& str) {
        string result ="";

        for(char c : str){
            if(c != '#'){
               result.push_back(c);
            }
            else if(!result.empty()){
                result.pop_back();
            }
        }
        return result;
    }
};
