#include <iostream>
#include <vector>
#include <algorithm>
 
using namespace std;
 
void findAnswer(long long current, int count4, int count7, vector<long long>& ans) {
    if (current > 10000000000LL) {
        return;
    }
    
    if (count4 == count7 && count4 > 0) {
        ans.push_back(current);
    }
    
    findAnswer(current * 10 + 4, count4 + 1, count7, ans);
    findAnswer(current * 10 + 7, count4, count7 + 1, ans);
}
 
int main() {
    long long n;
    cin >> n;
    
    vector<long long> ans;
    findAnswer(0, 0, 0, ans);
    
    sort(ans.begin(), ans.end());
    
    for (int i = 0; i < ans.size(); i++) {
        if (ans[i] >= n) {
            cout << ans[i] << "\n";
            break;
        }
    }
    
    return 0;
}
