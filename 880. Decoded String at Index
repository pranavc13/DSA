class Solution {
public:
    string decodeAtIndex(string s, int k) {
        long long length = 0;
        for(int i=0; i<s.length(); i++){
            if(isdigit(s[i])){
                length = length*(s[i] - '0');
            }
            else {
                length++;
            }
        }
      
        for(int i=s.length()-1; i>=0; i--){
            k = k%length;
            if(!isdigit(s[i])){
                if(k==0){
                    return string(1, s[i]);
                }
                length--;
            }
            else {
                length = length/(s[i] - '0');
            }
        
        }
        return "";
    }
};
