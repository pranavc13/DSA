class Solution {
public:
    string replaceDigits(string s) {
       string result = "";
       for(int i=0; i<s.length(); i++){
        if(i%2 ==0){
            result += s[i];
        }
        else {
            char A = s[i - 1] + (s[i] - '0');
            result += A;
        }
       }
       return result;
        
    }
};
