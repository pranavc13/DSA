class Solution {
public:
    string largestOddNumber(string num) {
        string result = "";
        vector<char>odd = {'1', '3', '5', '7', '9'};
        vector<char>even = {'0', '2', '4', '6', '8'};
        for(int i= num.length()-1; i>=0; i--){
            if(find(odd.begin(), odd.end(), num[i]) != odd.end()){
                return num.substr(0, i+1);
            }
            
        }
        return "";
    }
};
