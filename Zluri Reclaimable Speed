#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    int n;
    cin>>n;
    vector<pair<int, int>>ans(n);
    for(int i=0; i<n; i++){
        string email;
        int days, cost;
        cin>>email>>days>>cost;
        ans[i] = {days, cost};
    }
    int d;
    cin>>d;
    long long totalSum = 0;
    for(int i=0; i<n; i++){
        int days = ans[i].first;
        int cost = ans[i].second;
        if(days == -1 || days>=d){
            totalSum += cost;
        }
    }
    cout<<totalSum<<"\n";
    return 0;
}
