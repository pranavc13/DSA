class Solution {
public:
vector<string> num = {"", "", "abc", "def", "ghi", "jkl","mno","pqrs",  "tuv", "wxyz"};
    void solve(string digits, int index, string& currentStr, vector<string>& ans){
        if(index == digits.size()){
            ans.push_back(currentStr);
            return;
        }
        int number = digits[index] - '0';
        string letters = num[number];
        for(int i=0; i<letters.length(); i++){
            currentStr += letters[i];
            solve(digits, index+1, currentStr, ans);
            currentStr.pop_back();
        }
    }
    

    vector<string> letterCombinations(string digits) {
        vector<string> ans;
        if(digits.length() == 0){
            return ans;
        }
        string currentStr = "";
        solve(digits, 0, currentStr, ans);
        return ans;

    }
};
